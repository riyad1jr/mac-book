{
  "name": "mame-inventory",
  "private": true,
  "version": "0.5.0",
  "description": "Mame Inventory Management desktop app",
  "author": "Mame",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server && npm run build:runtime",
    "build:server": "node_modules/.bin/esbuild scripts/server/index.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=build/server.cjs",
    "build:runtime": "node scripts/copy-runtime.cjs",
    "preview": "vite preview",
    "server": "tsx watch scripts/server/index.ts",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/dist-win.cjs"
  },
  "build": {
    "appId": "com.mame.inventory",
    "productName": "Mame Inventory",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "scripts/installer.nsh",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "asarUnpack": [
      "build/**/*"
    ],
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "express": "4.22.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
